# 1. Lambda to calculate the sum of digits
digit_sum = lambda n: sum(int(digit) for digit in str(abs(n)))


# 2. Lambda to calculate the product of digits
digit_product = lambda n: __import__('math').prod(int(digit) for digit in str(abs(n)))


# 3. Lambda to check whether a number is prime
is_prime = lambda n: n > 1 and all(n % i != 0 for i in range(2, int(n**0.5) + 1))


# 4. Lambda to check whether a number is an Armstrong number
is_armstrong = lambda n: n >= 0 and n == sum(int(digit) ** len(str(n)) for digit in str(n))


# 5. Lambda to check whether a number is a Spy number
is_spy = lambda n: n >= 0 and digit_sum(n) == digit_product(n)


# 6. Lambda to check whether a number is a Neon number
is_neon = lambda n: n >= 0 and digit_sum(n * n) == n


# 7. Lambda to check whether a number is a palindrome
is_palindrome = lambda n: str(n) == str(n)[::-1]


# 8. Lambda to check whether a number is a perfect number
is_perfect = lambda n: n > 1 and sum(i for i in range(1, n) if n % i == 0) == n


# 9. Combined lambda: number must be both prime and palindrome
is_prime_palindrome = lambda n: is_prime(n) and is_palindrome(n)


# Testing the functions
print("Digit sum of 123:", digit_sum(123))
print("Digit product of 123:", digit_product(123))

print("Is 7 prime?", is_prime(7))
print("Is 153 Armstrong?", is_armstrong(153))
print("Is 123 Spy?", is_spy(123))
print("Is 9 Neon?", is_neon(9))
print("Is 121 palindrome?", is_palindrome(121))
print("Is 28 perfect?", is_perfect(28))

print("Is 131 both prime and palindrome?", is_prime_palindrome(131))
