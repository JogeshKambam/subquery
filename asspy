
# 1. Prime Number
is_prime = lambda n: n > 1 and all(n % i != 0 for i in range(2, n))
print(is_prime(7))


# 2. Armstrong Number
is_armstrong = lambda n: n == sum(int(digit) ** len(str(n)) for digit in str(n))
print(is_armstrong(153))


# 3. Spy Number
is_spy = lambda n: sum(int(digit) for digit in str(n)) == __import__('math').prod(int(digit) for digit in str(n))
print(is_spy(123))


# 4. Neon Number
is_neon = lambda n: sum(int(digit) for digit in str(n * n)) == n
print(is_neon(9))


# 5. Digit Sum
digit_sum = lambda n: sum(int(digit) for digit in str(n))
print(digit_sum(123))


# 6. Digit Product
digit_product = lambda n: __import__('math').prod(int(digit) for digit in str(n))
print(digit_product(123))


# 7. Palindrome Number
is_palindrome = lambda n: str(n) == str(n)[::-1]
print(is_palindrome(121))


# 8. Perfect Number
is_perfect = lambda n: sum(i for i in range(1, n) if n % i == 0) == n
print(is_perfect(28))


# 9. Combined Lambda (Prime and Palindrome)
is_prime_palindrome = lambda n: is_prime(n) and is_palindrome(n)
print(is_prime_palindrome(131))

