use company;
show tables;
#DDL
create table department(dept_id int primary key auto_increment,dept_name varchar(30),location varchar(30));
select * from department;
create table employee(emp_id int primary key auto_increment,emp_name varchar(30),job varchar(30),manager_id int,hire_date date,salary int,commission int,dept_id int,foreign key (dept_id) references department(dept_id));
select * from employee;
desc employee;
desc department;
desc projects;
create table project(proj_id int primary key auto_increment,proj_name varchar(30) unique not null,budget decimal(10,2) check (budget>0),dept_id int,foreign key (dept_id) references department(dept_id));
select *  from projects;
alter table project
add column start_date date;
alter table project
modify proj_name varchar(50);
rename table project to projects;
set sql_safe_updates=0;
alter table projects drop start_date;
truncate projects;
