#FUCTIONS
#SINGLE ROW FUNCTIONS
select upper(emp_name),length(emp_name),left(emp_name,3) from employee;
select concat(emp_name,"-",job) as ej from employee;
select timestampdiff(year, hire_date, curdate()),monthname(hire_date) from employee;
select salary+ifnull(commission,0) as totalpay from employee;
select emp_name,case when salary>=80000 then "high" when salary>=50000 then "medium" else "low" end as level  from employee;
select round(salary),mod(salary,7) from employee; 
#aggregate functions
select sum(salary),avg(salary),min(salary),max(salary),count(*) from employee;
select count(*),count(commission),count(distinct dept_id) from employee;
select avg(salary),dept_id from employee group by dept_id having avg(salary)>50000;
select job,count(*) from employee group by job;
select dept_id,emp_name,max(salary) from employee group by dept_id;
#where is to filter condtion while having is also a filter condtion to filter the group by conditons.
#WINDOW FUNCTIONS
select salary,dept_id,row_number() over (partition by dept_id order by salary desc) as rn,dense_rank() over(partition by dept_id order by salary desc) as dr,rank() over(partition by dept_id order by salary desc) as r from employee;
select salary,dept_id,avg(salary) over (partition by dept_id) from employee;
select hire_date,salary,SUM(salary) OVER (ORDER BY hire_date) AS running_total from employee;
SELECT hire_date,salary,LAG(salary) OVER (ORDER BY hire_date) AS previous_salary,
LEAD(salary) OVER (ORDER BY hire_date) AS next_salary FROM employee;
WITH ranked_employees AS (SELECT emp_id,emp_name,dept_id,salary,DENSE_RANK() OVER (
PARTITION BY dept_id ORDER BY salary DESC) AS salary_rank FROM employee)
SELECT * FROM ranked_employees WHERE salary_rank <= 2;
#Groups rows together	in window function Retains individual rows
#JOINS
#inner
select e.emp_name,e.job,d.dept_name,d.location
from employee e inner join department d
on e.dept_id=d.dept_id;
select count(e.emp_id),e.dept_id,d.dept_name from employee e inner join department d on d.dept_id=e.dept_id group by d.dept_id,d.dept_name;
#left&right
select e.emp_name,d.dept_name from employee e left outer join department d on e.dept_id=d.dept_id;
select e.emp_name as employee,e1.emp_name as empmgr
from employee e join employee e1
on e.manager_id=e1.emp_id;

select * from employee;

select e.emp_name,count(e.emp_id) as m
from employee e join employee e1
on e1.manager_id=e.emp_id
group by e.emp_name;
select e1.emp_name,e1.salary,e.emp_name,e.salary
from employee e join employee e1
on e.manager_id=e1.emp_id
where e.salary<e1.salary;
select * from employee ;
select e.emp_name,e1.emp_name,e1.job
from employee e join employee e1
on e.job=e1.job and e.dept_id=e1.dept_id and e.emp_id<e1.emp_id;
select e1.emp_name,e2.emp_name,e1.dept_id,e1.job
from employee e1 join employee e2
on e1.dept_id = e2.dept_id and e1.job = e2.job and e1.emp_id < e2.emp_id;
